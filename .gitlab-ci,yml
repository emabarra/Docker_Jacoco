image: eclipse-temurin:17-jdk-alpine # Imagen base con Java

stages:
  - test

ejecutar_tests:
  stage: test
  script:
    # Si usas Maven:
    - ./mvnw clean test
    # Si usas Gradle, descomenta la siguiente línea y comenta la de arriba:
    # - ./gradlew test jacocoTestReport
  artifacts:
    name: "reporte-jacoco-${CI_COMMIT_REF_SLUG}"
    when: always
    paths:
      - target/site/jacoco/      # Ruta para Maven
      - build/reports/jacoco/    # Ruta para Gradle
    expire_in: 1 week